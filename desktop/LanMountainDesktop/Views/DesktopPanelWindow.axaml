<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
        xmlns:fi="using:FluentIcons.Avalonia"
        x:Class="LanMountainDesktop.Views.DesktopPanelWindow"
        Title="Desktop Panel"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Background="Transparent"
        Topmost="False"
        SizeToContent="Manual"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        Focusable="True"
        RenderOptions.BitmapInterpolationMode="HighQuality">

    <Window.Styles>
        <Style Selector="Border.panel-component-host">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.panel-component-host.panel-edit-host">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        </Style>
        <Style Selector="Border.panel-component-host.panel-edit-host:pointerover">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="Border.panel-component-host.panel-edit-host.panel-selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AdaptiveAccentBrush}" />
        </Style>
    </Window.Styles>

    <Border x:Name="PanelShell"
            Classes="surface-translucent-strong"
            CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
            ClipToBounds="True"
            BoxShadow="none">
        <Grid>
            <Grid x:Name="PanelGrid"
                  Background="Transparent"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  PointerPressed="OnPanelBackgroundPointerPressed" />

            <StackPanel x:Name="EmptyStatePanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6"
                        Margin="12">
                <lucide:LucideIcon x:Name="EmptyStateIcon"
                               Kind="LayoutGrid"
 Width="28" Height="28"
                               Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                               HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyStateTitleTextBlock"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{arc:ArcDesignTokenResource Foreground}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="EmptyStateDescriptionTextBlock"
                           FontSize="12"
                           Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="360" />
                <arc:Button
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        Click="OnPanelAddComponentClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <lucide:LucideIcon Kind="Plus" Width="14" Height="14" />
                        <TextBlock x:Name="AddComponentButtonTextBlock" />
                    </StackPanel>
                </arc:Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
