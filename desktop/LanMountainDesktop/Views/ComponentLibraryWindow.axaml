<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
        xmlns:vm="using:LanMountainDesktop.ViewModels"
        xmlns:fi="using:FluentIcons.Avalonia"
        x:Class="LanMountainDesktop.Views.ComponentLibraryWindow"
        x:DataType="vm:ComponentLibraryWindowViewModel"
        Width="980"
        Height="620"
        MinWidth="760"
        MinHeight="500"
        CanResize="True"
        WindowDecorations="Full"
        Title="Component Library"
        Background="{arc:ArcDesignTokenResource Background}">

    <Grid RowDefinitions="Auto,*"
          RowSpacing="10"
          Margin="14">
        <Grid ColumnDefinitions="*,Auto"
              Margin="6,4,6,0">
            <TextBlock VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{arc:ArcDesignTokenResource Foreground}"
                       Text="{Binding Title}" />
            <arc:Button Grid.Column="1"
                    Width="34"
                    Height="34"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnCloseClick">
                <lucide:LucideIcon Kind="X"
 />
            </arc:Button>
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="240,*"
              ColumnSpacing="12">
            <Border Classes="surface-translucent-panel"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                    Padding="10">
                <ListBox x:Name="CategoryListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="OnCategorySelectionChanged"
                         ItemsSource="{Binding Categories}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ComponentLibraryCategoryViewModel">
                            <Border Padding="10"
                                    Margin="0,0,0,6"
                                    CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}">
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="8">
                                    <lucide:LucideIcon Kind="{Binding Icon}"
                                                   Width="16"
                                                   Height="16"
                                                   VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="{arc:ArcDesignTokenResource Foreground}"
                                               Text="{Binding Title}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1"
                    Classes="surface-translucent-strong"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                    Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Components}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ComponentLibraryItemViewModel">
                                <Border Width="240"
                                        Height="220"
                                        Margin="6"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                        Padding="10"
                                        Background="{arc:ArcDesignTokenResource SurfaceRaised}"
                                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                        BorderThickness="1">
                                    <Grid RowDefinitions="*,Auto,Auto"
                                          RowSpacing="8">
                                        <Border CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                                Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                BorderThickness="1"
                                                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                Padding="8">
                                            <ContentControl Content="{Binding PreviewControl}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            IsHitTestVisible="False"
                                                            Focusable="False" />
                                        </Border>

                                        <TextBlock Grid.Row="1"
                                                   HorizontalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                   Text="{Binding DisplayName}" />

                                        <arc:Button Grid.Row="2"
                                                HorizontalAlignment="Center"
                                                Padding="12,6"
                                                Tag="{Binding ComponentId}"
                                                Click="OnAddComponentClick">
                                            <TextBlock Text="Add to Desktop" />
                                        </arc:Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
