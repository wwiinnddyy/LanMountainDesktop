<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LanMountainDesktop.ViewModels"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="LanMountainDesktop.Views.SettingsPages.StudySettingsPage"
             x:DataType="vm:StudySettingsPageViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Classes="settings-page-container settings-page-animated">

            <!-- 主开关 -->
            <arc:SettingsGroup>
                <arc:SettingsRow Header="{Binding MasterSwitchHeader}"
                                 Description="{Binding MasterSwitchDescription}">
                    <arc:Switch IsChecked="{Binding StudyEnabled}" />
                </arc:SettingsRow>
            </arc:SettingsGroup>

            <!-- 噪声监测 -->
            <arc:SettingsGroup Header="{Binding NoiseMonitoringHeader}"
                               Description="{Binding NoiseMonitoringDescription}"
                               IsEnabled="{Binding StudyEnabled}"
                               Margin="0,16,0,0">
                <arc:SettingsRow Header="{Binding SamplingRateLabel}"
                                 Description="{Binding SamplingRateDescription}">
                    <arc:Slider Minimum="20"
                                Maximum="200"
                                Width="260"
                                Value="{Binding SamplingRateMs}"
                                IsValueVisible="True" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding NoiseSensitivityLabel}"
                                 Description="{Binding NoiseSensitivityDescription}">
                    <arc:Slider Minimum="-70"
                                Maximum="-35"
                                Width="260"
                                Value="{Binding NoiseSensitivityDbfs}"
                                IsValueVisible="True" />
                </arc:SettingsRow>
                <arc:SettingsRow>
                    <arc:SettingsRow.Details>
                        <TextBlock Classes="settings-item-description"
                                   Text="{Binding CurrentThresholdText}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </arc:SettingsRow.Details>
                </arc:SettingsRow>
            </arc:SettingsGroup>

            <!-- 专注计时 -->
            <arc:SettingsGroup Header="{Binding FocusTimerHeader}"
                               Description="{Binding FocusTimerDescription}"
                               IsEnabled="{Binding StudyEnabled}"
                               Margin="0,16,0,0">
                <arc:SettingsRow Header="{Binding FocusDurationLabel}"
                                 Description="{Binding FocusDurationDescription}">
                    <arc:Slider Minimum="5"
                                Maximum="90"
                                Width="260"
                                Value="{Binding FocusDurationMinutes}"
                                IsValueVisible="True" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding BreakDurationLabel}"
                                 Description="{Binding BreakDurationDescription}">
                    <arc:Slider Minimum="1"
                                Maximum="30"
                                Width="260"
                                Value="{Binding BreakDurationMinutes}"
                                IsValueVisible="True" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding LongBreakDurationLabel}"
                                 Description="{Binding LongBreakDurationDescription}">
                    <arc:Slider Minimum="5"
                                Maximum="60"
                                Width="260"
                                Value="{Binding LongBreakDurationMinutes}"
                                IsValueVisible="True" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding SessionsBeforeLongBreakLabel}"
                                 Description="{Binding SessionsBeforeLongBreakDescription}">
                    <arc:Slider Minimum="2"
                                Maximum="8"
                                Width="260"
                                Value="{Binding SessionsBeforeLongBreak}"
                                IsValueVisible="True" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding AutoStartBreakLabel}"
                                 Description="{Binding AutoStartBreakDescription}">
                    <arc:Switch IsChecked="{Binding AutoStartBreak}" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding AutoStartFocusLabel}"
                                 Description="{Binding AutoStartFocusDescription}">
                    <arc:Switch IsChecked="{Binding AutoStartFocus}" />
                </arc:SettingsRow>
            </arc:SettingsGroup>

            <!-- 提醒 -->
            <arc:SettingsGroup Header="{Binding AlertHeader}"
                               Description="{Binding AlertDescription}"
                               IsEnabled="{Binding StudyEnabled}"
                               Margin="0,16,0,0">
                <arc:SettingsRow Header="{Binding NoiseAlertEnabledLabel}"
                                 Description="{Binding NoiseAlertEnabledDescription}">
                    <arc:Switch IsChecked="{Binding NoiseAlertEnabled}" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding MaxInterruptsPerMinuteLabel}"
                                 Description="{Binding MaxInterruptsPerMinuteDescription}"
                                 IsVisible="{Binding NoiseAlertEnabled}">
                    <arc:NumberField Width="120"
                                     Minimum="3"
                                     Maximum="20"
                                     Value="{Binding MaxInterruptsPerMinute}" />
                </arc:SettingsRow>
            </arc:SettingsGroup>

            <!-- 显示 -->
            <arc:SettingsGroup Header="{Binding DisplayHeader}"
                               Description="{Binding DisplayDescription}"
                               IsEnabled="{Binding StudyEnabled}"
                               Margin="0,16,0,0">
                <arc:SettingsRow Header="{Binding ShowRealtimeDbLabel}"
                                 Description="{Binding ShowRealtimeDbDescription}">
                    <arc:Switch IsChecked="{Binding ShowRealtimeDb}" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding BaselineDbLabel}"
                                 Description="{Binding BaselineDbDescription}">
                    <arc:Slider Minimum="20"
                                Maximum="90"
                                Width="260"
                                Value="{Binding BaselineDb}"
                                IsValueVisible="True" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding AvgWindowSecLabel}"
                                 Description="{Binding AvgWindowSecDescription}">
                    <arc:Slider Minimum="1"
                                Maximum="8"
                                Width="260"
                                Value="{Binding AvgWindowSec}"
                                IsValueVisible="True" />
                </arc:SettingsRow>
            </arc:SettingsGroup>

            <TextBlock Classes="settings-item-description"
                       Margin="0,8,0,0"
                       Text="{Binding FooterHint}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
