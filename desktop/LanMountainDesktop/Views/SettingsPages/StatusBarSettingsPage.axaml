<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LanMountainDesktop.ViewModels"
             xmlns:controls="using:LanMountainDesktop.Controls"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="LanMountainDesktop.Views.SettingsPages.StatusBarSettingsPage"
             x:DataType="vm:StatusBarSettingsPageViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Classes="settings-page-container settings-page-animated">
            <controls:IconText Icon="Apps"
                               Text="{Binding ComponentsHeader}"
                               Margin="0,0,0,4" />

            <arc:SettingsGroup Header="{Binding ClockHeader}"
                               Description="{Binding ClockDescription}">
                <arc:SettingsRow Header="{Binding ClockFormatLabel}">
                    <arc:Select Width="220"
                                IsEnabled="{Binding ShowClock}"
                                ItemsSource="{Binding ClockFormats}"
                                SelectedItem="{Binding SelectedClockFormat}"
                                DisplayMemberBinding="{Binding Label}" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding ClockTransparentBackgroundLabel}"
                                 Description="{Binding ClockTransparentBackgroundDescription}">
                    <arc:Switch IsChecked="{Binding ClockTransparentBackground}" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding ClockPositionLabel}">
                    <arc:Select Width="220"
                                IsEnabled="{Binding ShowClock}"
                                ItemsSource="{Binding ClockPositions}"
                                SelectedItem="{Binding SelectedClockPosition}"
                                DisplayMemberBinding="{Binding Label}" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding ClockFontSizeLabel}">
                    <arc:Select Width="220"
                                IsEnabled="{Binding ShowClock}"
                                ItemsSource="{Binding ClockFontSizes}"
                                SelectedItem="{Binding SelectedClockFontSize}"
                                DisplayMemberBinding="{Binding Label}" />
                </arc:SettingsRow>
                <arc:SettingsRow>
                    <arc:Switch IsChecked="{Binding ShowClock}" />
                </arc:SettingsRow>
            </arc:SettingsGroup>

            <arc:SettingsGroup Header="{Binding TextCapsuleHeader}"
                               Description="{Binding TextCapsuleDescription}"
                               Margin="0,16,0,0">
                <arc:SettingsRow Header="{Binding TextCapsuleContentLabel}">
                    <arc:Input AcceptsReturn="True"
                               TextWrapping="Wrap"
                               Height="100"
                               Width="420"
                               IsEnabled="{Binding ShowTextCapsule}"
                               Text="{Binding TextCapsuleContent}"
                               Placeholder="{Binding TextCapsulePlaceholder}" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding TextCapsulePositionLabel}">
                    <arc:Select Width="220"
                                IsEnabled="{Binding ShowTextCapsule}"
                                ItemsSource="{Binding TextCapsulePositions}"
                                SelectedItem="{Binding SelectedTextCapsulePosition}"
                                DisplayMemberBinding="{Binding Label}" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding TextCapsuleTransparentBackgroundLabel}">
                    <arc:Switch IsChecked="{Binding TextCapsuleTransparentBackground}"
                                IsEnabled="{Binding ShowTextCapsule}" />
                </arc:SettingsRow>
                <arc:SettingsRow>
                    <arc:Switch IsChecked="{Binding ShowTextCapsule}" />
                </arc:SettingsRow>
            </arc:SettingsGroup>

            <arc:SettingsGroup Header="{Binding NetworkSpeedHeader}"
                               Description="{Binding NetworkSpeedDescription}"
                               Margin="0,16,0,0">
                <arc:SettingsRow Header="{Binding NetworkSpeedPositionLabel}">
                    <arc:Select Width="220"
                                IsEnabled="{Binding ShowNetworkSpeed}"
                                ItemsSource="{Binding NetworkSpeedPositions}"
                                SelectedItem="{Binding SelectedNetworkSpeedPosition}"
                                DisplayMemberBinding="{Binding Label}" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding NetworkSpeedDisplayModeLabel}">
                    <arc:Select Width="220"
                                IsEnabled="{Binding ShowNetworkSpeed}"
                                ItemsSource="{Binding NetworkSpeedDisplayModes}"
                                SelectedItem="{Binding SelectedNetworkSpeedDisplayMode}"
                                DisplayMemberBinding="{Binding Label}" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding NetworkSpeedTransparentBackgroundLabel}">
                    <arc:Switch IsChecked="{Binding NetworkSpeedTransparentBackground}"
                                IsEnabled="{Binding ShowNetworkSpeed}" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding ShowNetworkTypeIconLabel}">
                    <arc:Switch IsChecked="{Binding ShowNetworkTypeIcon}"
                                IsEnabled="{Binding ShowNetworkSpeed}" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding NetworkSpeedFontSizeLabel}">
                    <arc:Select Width="220"
                                IsEnabled="{Binding ShowNetworkSpeed}"
                                ItemsSource="{Binding NetworkSpeedFontSizes}"
                                SelectedItem="{Binding SelectedNetworkSpeedFontSize}"
                                DisplayMemberBinding="{Binding Label}" />
                </arc:SettingsRow>
                <arc:SettingsRow>
                    <arc:Switch IsChecked="{Binding ShowNetworkSpeed}" />
                </arc:SettingsRow>
            </arc:SettingsGroup>

            <Separator Classes="settings-separator" />

            <controls:IconText Icon="Apps"
                               Text="{Binding SpacingHeader}"
                               Margin="0,0,0,4" />

            <arc:SettingsGroup Header="{Binding SpacingHeader}"
                               Description="{Binding SpacingDescription}">
                <arc:SettingsRow>
                    <arc:Select Width="180"
                                ItemsSource="{Binding SpacingModes}"
                                SelectedItem="{Binding SelectedSpacingMode}"
                                DisplayMemberBinding="{Binding Label}" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding CustomSpacingLabel}"
                                 IsVisible="{Binding IsCustomSpacingVisible}">
                    <arc:NumberField Width="160"
                                     Minimum="0"
                                     Maximum="30"
                                     Value="{Binding CustomSpacingPercent}" />
                </arc:SettingsRow>
            </arc:SettingsGroup>

            <Separator Classes="settings-separator" />

            <controls:IconText Icon="Square"
                               Text="{Binding StatusBarShadowHeader}"
                               Margin="0,0,0,4" />

            <arc:SettingsGroup Header="{Binding StatusBarShadowHeader}"
                               Description="{Binding StatusBarShadowDescription}">
                <arc:SettingsRow Header="{Binding StatusBarShadowColorLabel}">
                    <arc:Button HorizontalAlignment="Right"
                                IsEnabled="{Binding StatusBarShadowEnabled}">
                        <Border Width="32"
                                Height="32"
                                CornerRadius="4"
                                Background="{Binding StatusBarShadowColorBrush}" />
                        <arc:Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <ColorPicker Color="{Binding StatusBarShadowColor}" />
                            </Flyout>
                        </arc:Button.Flyout>
                    </arc:Button>
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding StatusBarShadowOpacityLabel}">
                    <arc:Slider Minimum="0"
                                Maximum="100"
                                Width="260"
                                IsEnabled="{Binding StatusBarShadowEnabled}"
                                Value="{Binding StatusBarShadowOpacity}"
                                IsValueVisible="False" />
                </arc:SettingsRow>
                <arc:SettingsRow>
                    <arc:Switch IsChecked="{Binding StatusBarShadowEnabled}" />
                </arc:SettingsRow>
            </arc:SettingsGroup>
        </StackPanel>
    </ScrollViewer>
</UserControl>
