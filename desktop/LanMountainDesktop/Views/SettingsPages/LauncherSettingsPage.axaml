<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LanMountainDesktop.ViewModels"
             xmlns:controls="using:LanMountainDesktop.Controls"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="LanMountainDesktop.Views.SettingsPages.LauncherSettingsPage"
             x:DataType="vm:LauncherSettingsPageViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Classes="settings-page-container settings-page-animated">

            <controls:IconText Icon="Apps"
                               Text="{Binding LauncherHeader}"
                               Margin="0,0,0,4" />
            <TextBlock Classes="settings-item-description"
                       Margin="0,0,0,16"
                       Text="{Binding LauncherSubtitle}" />

            <arc:SettingsGroup Header="{Binding AppearanceHeader}"
                               Description="{Binding AppearanceDescription}">
                <arc:SettingsRow Header="{Binding ShowTileBackgroundHeader}"
                                 Description="{Binding ShowTileBackgroundDescription}">
                    <arc:Switch IsChecked="{Binding ShowTileBackground}" />
                </arc:SettingsRow>
            </arc:SettingsGroup>

            <Separator Classes="settings-separator" />

            <arc:SettingsGroup Header="{Binding HiddenHeader}"
                               Description="{Binding HiddenDescription}">
                <TextBlock Classes="settings-item-description"
                           IsVisible="{Binding IsHiddenItemsEmpty}"
                           Margin="0,4,0,8"
                           Text="{Binding HiddenEmptyText}"
                           TextWrapping="Wrap" />

                <ItemsControl ItemsSource="{Binding HiddenItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LauncherHiddenItemViewModel">
                            <arc:SettingsRow Header="{Binding DisplayName}"
                                             Description="{Binding TypeLabel}">
                                <arc:Button Command="{Binding RestoreCommand}" Content="{Binding RestoreButtonText}" VerticalAlignment="Center" />
                            </arc:SettingsRow>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <arc:SettingsGroup.Footer>
                    <TextBlock Classes="settings-item-description"
                               Text="{Binding HiddenCountText}"
                               VerticalAlignment="Center" />
                </arc:SettingsGroup.Footer>
            </arc:SettingsGroup>
        </StackPanel>
    </ScrollViewer>
</UserControl>
