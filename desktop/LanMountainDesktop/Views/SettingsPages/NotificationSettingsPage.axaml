<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LanMountainDesktop.ViewModels"
             xmlns:controls="using:LanMountainDesktop.Controls"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             x:Class="LanMountainDesktop.Views.SettingsPages.NotificationSettingsPage"
             x:DataType="vm:NotificationSettingsPageViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Classes="settings-page-container settings-page-animated">

            <controls:IconText Icon="Alert"
                               Text="{Binding NotificationHeader}"
                               Margin="0,0,0,4" />

            <arc:SettingsGroup>
                <arc:SettingsRow Header="{Binding EnableNotificationHeader}"
                                 Description="{Binding EnableNotificationDescription}">
                    <arc:Switch IsChecked="{Binding IsNotificationEnabled}" />
                </arc:SettingsRow>
            </arc:SettingsGroup>

            <Separator Classes="settings-separator" />

            <controls:IconText Icon="Alert"
                               Text="{Binding BehaviorHeader}"
                               Margin="0,0,0,4" />

            <arc:SettingsGroup>
                <arc:SettingsRow Header="{Binding HoverPauseHeader}"
                                 Description="{Binding HoverPauseDescription}">
                    <arc:Switch IsChecked="{Binding IsHoverPauseEnabled}" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding ClickCloseHeader}"
                                 Description="{Binding ClickCloseDescription}">
                    <arc:Switch IsChecked="{Binding IsClickCloseEnabled}" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding MaxNotificationsHeader}"
                                 Description="{Binding MaxNotificationsDescription}">
                    <arc:NumberField Value="{Binding MaxNotificationsPerPosition}"
                                     Minimum="1"
                                     Maximum="10"
                                     Width="100" />
                </arc:SettingsRow>
            </arc:SettingsGroup>

            <Separator Classes="settings-separator" />

            <controls:IconText Icon="Alert"
                               Text="{Binding NotificationBoxHeader}"
                               Margin="0,0,0,4" />

            <arc:SettingsGroup>
                <arc:SettingsRow Header="{Binding NotificationBoxEnabledHeader}"
                                 Description="{Binding NotificationBoxEnabledDescription}">
                    <arc:Switch IsChecked="{Binding IsNotificationBoxEnabled}" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding NotificationBoxPrivacyHeader}"
                                 Description="{Binding NotificationBoxPrivacyDescription}">
                    <arc:Switch IsChecked="{Binding IsNotificationBoxPrivacyMode}" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding LinuxCaptureModeHeader}"
                                 Description="{Binding LinuxCaptureModeDescription}">
                    <arc:Select Width="180"
                                ItemsSource="{Binding LinuxCaptureModes}"
                                SelectedItem="{Binding SelectedLinuxCaptureMode}"
                                DisplayMemberBinding="{Binding Label}" />
                </arc:SettingsRow>
            </arc:SettingsGroup>

            <Separator Classes="settings-separator" />

            <controls:IconText Icon="Beaker"
                               Text="{Binding TestHeader}"
                               Margin="0,0,0,4" />

            <arc:SettingsGroup>
                <arc:SettingsRow Header="{Binding TestNotificationHeader}"
                                 Description="{Binding TestNotificationDescription}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <arc:Select Width="120"
                                    ItemsSource="{Binding TestPositions}"
                                    SelectedItem="{Binding SelectedTestPosition}"
                                    DisplayMemberBinding="{Binding Label}" />
                        <arc:Select Width="100"
                                    ItemsSource="{Binding TestSeverities}"
                                    SelectedItem="{Binding SelectedTestSeverity}"
                                    DisplayMemberBinding="{Binding Label}" />
                        <arc:NumberField Width="100"
                                         Minimum="1"
                                         Maximum="30"
                                         Value="{Binding TestDurationSeconds}" />
                        <arc:Button Variant="Primary"
                                    Command="{Binding SendTestCommand}"
                                    VerticalAlignment="Center">
                            <lucide:LucideIcon Kind="Send" Width="16" Height="16" />
                        </arc:Button>
                    </StackPanel>
                </arc:SettingsRow>
            </arc:SettingsGroup>

        </StackPanel>
    </ScrollViewer>
</UserControl>
