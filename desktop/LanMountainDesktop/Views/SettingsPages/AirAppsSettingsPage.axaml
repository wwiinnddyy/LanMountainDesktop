<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LanMountainDesktop.ViewModels"
             xmlns:controls="using:LanMountainDesktop.Controls"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="LanMountainDesktop.Views.SettingsPages.AirAppsSettingsPage"
             x:Name="Root"
             x:DataType="vm:AirAppsSettingsPageViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Classes="settings-page-container settings-page-animated">
            <arc:SettingsRow Header="{Binding RefreshButtonText}"
                             Description="{Binding StatusMessage}">
                <arc:Button Command="{Binding RefreshCommand}" Content="{Binding RefreshButtonText}" />
            </arc:SettingsRow>

            <Separator Classes="settings-separator" />

            <controls:IconText Icon="PuzzleCube"
                               Text="{Binding InstalledHeader}"
                               Margin="0,0,0,4" />

            <ItemsControl ItemsSource="{Binding InstalledAirApps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InstalledAirAppItemViewModel">
                        <arc:SettingsRow Header="{Binding Name}"
                                         Description="{Binding Description}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <arc:Switch IsChecked="{Binding IsEnabled}" Command="{Binding #Root.DataContext.ToggleAirAppCommand}" CommandParameter="{Binding}" />
                                <arc:Button Command="{Binding #Root.DataContext.DeleteAirAppCommand}" CommandParameter="{Binding}" Content="{Binding #Root.DataContext.DeleteButtonText}" />
                            </StackPanel>
                        </arc:SettingsRow>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
