<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LanMountainDesktop.ViewModels"
             xmlns:controls="using:LanMountainDesktop.Controls"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="LanMountainDesktop.Views.SettingsPages.AppearanceSettingsPage"
             x:DataType="vm:AppearanceSettingsPageViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Classes="settings-page-container settings-page-animated">
            <controls:IconText Icon="Color"
                               Text="{Binding ThemeHeader}"
                               Margin="0,0,0,4" />

            <arc:SettingsGroup>
                <arc:SettingsRow Header="{Binding ThemeModeLabel}"
                                 Description="{Binding ThemeModeDescription}">
                    <arc:Select Width="200"
                                ItemsSource="{Binding ThemeModeOptions}"
                                DisplayMemberBinding="{Binding Label}"
                                SelectedItem="{Binding SelectedThemeMode}" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding UseSystemChromeLabel}">
                    <arc:Switch IsChecked="{Binding UseSystemChrome}" />
                </arc:SettingsRow>
            </arc:SettingsGroup>

        </StackPanel>
    </ScrollViewer>
</UserControl>
