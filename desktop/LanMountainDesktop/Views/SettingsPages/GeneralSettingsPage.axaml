<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LanMountainDesktop.ViewModels"
             xmlns:controls="using:LanMountainDesktop.Controls"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="LanMountainDesktop.Views.SettingsPages.GeneralSettingsPage"
             x:DataType="vm:GeneralSettingsPageViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Classes="settings-page-container settings-page-animated">
            <controls:IconText Icon="Globe"
                               Text="{Binding BasicHeader}"
                               Margin="0,0,0,4" />

            <!-- D6 承接：FASettingsExpander 卡 → arc:SettingsGroup（Card 外观）+ SettingsRow -->
            <arc:SettingsGroup>
                <arc:SettingsRow Header="{Binding LanguageHeader}">
                    <arc:Select Width="220"
                                ItemsSource="{Binding Languages}"
                                SelectedItem="{Binding SelectedLanguage}"
                                DisplayMemberBinding="{Binding Label}" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding TimeZoneHeader}"
                                 Description="{Binding TimeZoneDescription}">
                    <arc:Select Width="240"
                                ItemsSource="{Binding TimeZones}"
                                SelectedItem="{Binding SelectedTimeZone}"
                                DisplayMemberBinding="{Binding Label}" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding MultiInstanceLaunchBehaviorHeader}"
                                 Description="{Binding MultiInstanceLaunchBehaviorDescription}">
                    <arc:Select Width="240"
                                ItemsSource="{Binding MultiInstanceLaunchBehaviors}"
                                SelectedItem="{Binding SelectedMultiInstanceLaunchBehavior}"
                                DisplayMemberBinding="{Binding Label}" />
                </arc:SettingsRow>
            </arc:SettingsGroup>

            <arc:SettingsGroup Margin="0,16,0,0">
                <arc:SettingsRow Header="{Binding BackToWindowsButtonDisplayModeHeader}"
                                 Description="{Binding BackToWindowsButtonDisplayModeDescription}">
                    <arc:Select Width="220"
                                ItemsSource="{Binding BackToWindowsButtonDisplayModes}"
                                SelectedItem="{Binding SelectedBackToWindowsButtonDisplayMode}"
                                DisplayMemberBinding="{Binding Label}" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding BackToWindowsIconSourceHeader}"
                                 Description="{Binding BackToWindowsIconSourceDescription}">
                    <arc:Select Width="220"
                                ItemsSource="{Binding BackToWindowsIconSources}"
                                SelectedItem="{Binding SelectedBackToWindowsIconSource}"
                                DisplayMemberBinding="{Binding Label}" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding BackToWindowsFluentIconHeader}"
                                 Description="{Binding BackToWindowsFluentIconDescription}"
                                 IsVisible="{Binding IsBackToWindowsFluentIconSource}">
                    <arc:Button Width="220"
                                HorizontalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="10">
                            <fi:FluentIcon Width="18"
                                           Height="18"
                                           VerticalAlignment="Center"
                                           Icon="{Binding SelectedBackToWindowsFluentIcon.Icon}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectedBackToWindowsFluentIcon.Label}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <arc:Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <Border Width="388"
                                        MaxHeight="520"
                                        Padding="14">
                                    <StackPanel Spacing="12">
                                        <arc:Input Text="{Binding BackToWindowsFluentIconSearchText}"
                                                   Placeholder="{Binding BackToWindowsFluentIconSearchPlaceholder}" />
                                        <ListBox ItemsSource="{Binding FilteredBackToWindowsFluentIcons}"
                                                 SelectedItem="{Binding SelectedBackToWindowsFluentIcon}"
                                                 MaxHeight="400"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:FluentIconSelectionOption">
                                                    <StackPanel Width="76"
                                                                Height="68"
                                                                Spacing="6"
                                                                HorizontalAlignment="Center">
                                                        <fi:FluentIcon Width="24"
                                                                       Height="24"
                                                                       HorizontalAlignment="Center"
                                                                       Icon="{Binding Icon}" />
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="11"
                                                                   TextAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </arc:Button.Flyout>
                    </arc:Button>
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding BackToWindowsIconTextHeader}"
                                 Description="{Binding BackToWindowsIconTextDescription}"
                                 IsVisible="{Binding IsBackToWindowsTextIconSource}">
                    <arc:Input Width="160"
                               MaxLength="8"
                               Text="{Binding BackToWindowsIconText}" />
                </arc:SettingsRow>
            </arc:SettingsGroup>

            <arc:SettingsGroup Margin="0,16,0,0">
                <arc:SettingsRow Header="{Binding PreviewHeader}">
                    <arc:SettingsRow.Details>
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="16"
                              RowDefinitions="Auto,Auto"
                              RowSpacing="12"
                              Margin="0,4,0,0">
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding PreviewTimeLabel}" />
                            <TextBlock Grid.Column="1"
                                       Opacity="0.82"
                                       Text="{Binding PreviewTimeText}" />
                            <TextBlock Grid.Row="1"
                                       FontWeight="SemiBold"
                                       Text="{Binding PreviewDateLabel}" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Opacity="0.82"
                                       Text="{Binding PreviewDateText}" />
                        </Grid>
                    </arc:SettingsRow.Details>
                </arc:SettingsRow>
            </arc:SettingsGroup>

            <Separator Classes="settings-separator" />

            <controls:IconText Icon="DeveloperBoard"
                               Text="{Binding RuntimeHeader}"
                               Margin="0,0,0,4" />

            <arc:SettingsGroup>
                <arc:SettingsRow Header="{Binding RenderModeHeader}"
                                 Description="{Binding RuntimeDescription}">
                    <arc:SettingsRow.Details>
                        <TextBlock Text="{Binding RenderModeRestartMessage}"
                                   Opacity="0.7"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </arc:SettingsRow.Details>
                    <arc:Select Width="220"
                                ItemsSource="{Binding RenderModes}"
                                SelectedItem="{Binding SelectedRenderMode}"
                                DisplayMemberBinding="{Binding Label}" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding FadeTransitionHeader}"
                                 Description="{Binding FadeTransitionDescription}"
                                 IsVisible="{Binding IsSlideTransitionAvailable}">
                    <arc:Switch IsChecked="{Binding EnableFadeTransition}"
                                IsEnabled="{Binding IsFadeTransitionToggleEnabled}" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding SlideTransitionHeader}"
                                 Description="{Binding SlideTransitionDescription}"
                                 IsVisible="{Binding IsSlideTransitionAvailable}">
                    <arc:Switch IsChecked="{Binding EnableSlideTransition}" />
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding ShowInTaskbarHeader}"
                                 Description="{Binding ShowInTaskbarDescription}">
                    <arc:Switch IsChecked="{Binding ShowInTaskbar}" />
                </arc:SettingsRow>
            </arc:SettingsGroup>
        </StackPanel>
    </ScrollViewer>
</UserControl>
