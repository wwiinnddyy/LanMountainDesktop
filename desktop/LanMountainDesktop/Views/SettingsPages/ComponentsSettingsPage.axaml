<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LanMountainDesktop.ViewModels"
             xmlns:controls="using:LanMountainDesktop.Controls"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             x:Class="LanMountainDesktop.Views.SettingsPages.ComponentsSettingsPage"
             x:DataType="vm:ComponentsSettingsPageViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Classes="settings-page-container settings-page-animated">
            <Grid ColumnDefinitions="*,Auto"
                  Height="180"
                  Margin="0,0,0,16">
                <controls:GridPreviewControl Cells="{Binding ShortSideCells}"
                                             AspectRatio="{Binding ScreenAspectRatio}"
                                             EdgeInsetPercent="{Binding EdgeInsetPercent}"
                                             GridBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                             ScreenBorderBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                             InsetBrush="{DynamicResource ControlFillColorSecondaryBrush}"
                                             Margin="0,0,16,0" />
                <StackPanel Grid.Column="1"
                            Width="140"
                            Spacing="4">
                    <controls:CornerRadiusPreviewControl Radius="{Binding CornerRadiusPreviewValue}"
                                                         ShapeBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                                         GuideBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                                         FillBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                                         Height="120" />
                    <TextBlock Text="{Binding CornerRadiusPreviewValue, StringFormat='{}{0}px'}"
                               FontSize="11"
                               Opacity="0.65"
                               HorizontalAlignment="Center"
                               FontFamily="Consolas, Courier New" />
                </StackPanel>
            </Grid>

            <controls:IconText Icon="Apps"
                               Text="{Binding ComponentsHeader}"
                               Margin="0,0,0,4" />

            <arc:SettingsGroup Header="{Binding ComponentsHeader}">
                <arc:SettingsRow Header="{Binding ShortSideCellsLabel}">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <arc:Slider Width="200"
                                    Minimum="{Binding ShortSideCellsMinimum}"
                                    Maximum="{Binding ShortSideCellsMaximum}"
                                    Value="{Binding ShortSideCells}"
                                    IsValueVisible="False" />
                        <TextBlock Width="32"
                                   Text="{Binding ShortSideCells}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding EdgeInsetPercentLabel}">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <arc:Slider Width="200"
                                    Minimum="{Binding EdgeInsetPercentMinimum}"
                                    Maximum="{Binding EdgeInsetPercentMaximum}"
                                    Value="{Binding EdgeInsetPercent}"
                                    IsValueVisible="False" />
                        <TextBlock Width="32"
                                   Text="{Binding EdgeInsetPercent, StringFormat='{}{0}%'}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding SpacingPresetLabel}">
                    <arc:Select Width="180"
                                ItemsSource="{Binding SpacingPresets}"
                                SelectedItem="{Binding SelectedSpacingPreset}"
                                DisplayMemberBinding="{Binding Label}" />
                </arc:SettingsRow>
            </arc:SettingsGroup>

            <controls:IconText Icon="Apps"
                               Text="{Binding DesktopPanelHeader}"
                               Margin="0,12,0,4" />

            <arc:SettingsGroup Header="{Binding DesktopPanelHeader}"
                               Description="{Binding DesktopPanelDescription}">
                <arc:SettingsRow Header="{Binding DesktopPanelCellSizeLabel}">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <arc:Slider Width="200"
                                    Minimum="{Binding DesktopPanelCellSizeMinimum}"
                                    Maximum="{Binding DesktopPanelCellSizeMaximum}"
                                    Value="{Binding DesktopPanelCellSize}"
                                    IsValueVisible="False" />
                        <TextBlock Width="48"
                                   Text="{Binding DesktopPanelCellSize, StringFormat='{}{0:0}px'}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding DesktopPanelColumnsLabel}">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <arc:Slider Width="200"
                                    Minimum="{Binding DesktopPanelColumnsMinimum}"
                                    Maximum="{Binding DesktopPanelColumnsMaximum}"
                                    Value="{Binding DesktopPanelColumns}"
                                    IsValueVisible="False" />
                        <TextBlock Width="32"
                                   Text="{Binding DesktopPanelColumns}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding DesktopPanelRowsLabel}">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <arc:Slider Width="200"
                                    Minimum="{Binding DesktopPanelRowsMinimum}"
                                    Maximum="{Binding DesktopPanelRowsMaximum}"
                                    Value="{Binding DesktopPanelRows}"
                                    IsValueVisible="False" />
                        <TextBlock Width="32"
                                   Text="{Binding DesktopPanelRows}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </arc:SettingsRow>
                <arc:SettingsRow Header="{Binding DesktopPanelDockModeLabel}">
                    <arc:Select Width="220"
                                ItemsSource="{Binding DesktopPanelDockModeOptions}"
                                SelectedItem="{Binding SelectedDesktopPanelDockMode}"
                                DisplayMemberBinding="{Binding Label}" />
                </arc:SettingsRow>
                <arc:SettingsRow>
                    <arc:Switch IsChecked="{Binding EnableDesktopPanel, Mode=TwoWay}" />
                </arc:SettingsRow>
            </arc:SettingsGroup>

            <controls:IconText Icon="ShapeOrganic"
                               Text="{Binding ComponentRadiusHeader}"
                               Margin="0,12,0,4" />

            <arc:SettingsRow Header="{Binding CornerRadiusStyleLabel}"
                             Description="{Binding CornerRadiusStyleDescription}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <arc:Select Width="200"
                                ItemsSource="{Binding CornerRadiusStyleOptions}"
                                SelectedItem="{Binding SelectedCornerRadiusStyle}"
                                DisplayMemberBinding="{Binding Label}" />
                    <arc:Button ToolTip.Tip="{Binding CornerRadiusSpecTooltip}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenDesignSpecCommand}" CommandParameter="CORNER_RADIUS_SPEC.md">
                        <lucide:LucideIcon Kind="CircleHelp" />
                    </arc:Button>
                </StackPanel>
            </arc:SettingsRow>
        </StackPanel>
    </ScrollViewer>
</UserControl>
