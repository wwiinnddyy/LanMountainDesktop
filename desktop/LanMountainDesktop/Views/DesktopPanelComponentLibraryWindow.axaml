<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
        xmlns:controls="using:LanMountainDesktop.Views"
        xmlns:fi="using:FluentIcons.Avalonia"
        x:Class="LanMountainDesktop.Views.DesktopPanelComponentLibraryWindow"
        Width="860"
        Height="560"
        MinWidth="720"
        MinHeight="500"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Title="Add Component">

    <Grid x:Name="RootGrid"
          Classes="settings-scope"
          Background="Transparent">
        <Border x:Name="PanelShell"
                Classes="surface-translucent-strong"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Margin="0"
                Padding="0"
                CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                BoxShadow="none"
                ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">
                <Border Height="64"
                        Padding="24,0,24,0"
                        Background="Transparent"
                        PointerPressed="OnWindowTitleBarPointerPressed">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="WindowTitleTextBlock"
                                   VerticalAlignment="Center"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{arc:ArcDesignTokenResource Foreground}"
                                   Text="添加小组件" />
                        <arc:Button Grid.Column="1"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnCloseClick"
                                VerticalAlignment="Center">
                            <lucide:LucideIcon Kind="X"
 Width="16" Height="16" />
                        </arc:Button>
                    </Grid>
                </Border>

                <controls:DesktopPanelComponentLibraryControl x:Name="LibraryControl"
                                                              Grid.Row="1"
                                                              Margin="22,0,22,22" />
            </Grid>
        </Border>
    </Grid>
</Window>
